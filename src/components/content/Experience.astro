---
import cvFile from "../../assets/cv_en_adrian_beng_early_march_2026.pdf";
---

<section>
    <a name="experience" class="anchor"></a>
    <h2>Experience</h2>

    <ol>
        <li>
            <div class="role">
                <span class="title">WooCommerce + Shopify Developer</span>
                <span class="period">July 2023 — March 2026</span>
            </div>
            <p class="company">CodeSunrise</p>
            <p class="summary">
                Full-stack e-commerce developer with 40+ production sites on WooCommerce, Shopify Plus, Laravel, and Symfony—custom plugin/app development, theme builds, and migrations across both platforms.
            </p>
            <ul class="tags">
                <li>WooCommerce Themes & Plugins</li>
                <li>WordPress Designs</li>
                <li>Shopify Themes & Apps</li>
                <li>Custom Payment Gateways</li>
                <li>Shopify CLI + App Bridge</li>
                <li>GraphQL</li>
                <li>Third-Party Integrations</li>
                <li>Laravel & Symfony</li>
                <li>Migrations</li>
                <li>Repositories Management</li>
                <li>Documentation</li>
                <li>Git</li>
            </ul>
        </li>

        <li>
            <div class="role">
                <span class="title">Front-end Developer</span>
                <span class="period">March 2022 — July 2023</span>
            </div>
            <p class="company">OCWebguys</p>
            <p class="summary">
                Front-end specialist delivering pixel-perfect Figma/PSD builds with GSAP/Anime.js animations, Vue.js, and WordPress builders—plus 20+ optimized WordPress projects across security, performance, and SEO.
            </p>
            <ul class="tags">
                <li>Pixel-Perfect Designs</li>
                <li>Figma & PSD to Code</li>
                <li>GSAP/Anime.js</li>
                <li>WordPress + WP Builders</li>
                <li>Animated Themes</li>
                <li>SASS + CSS Frameworks</li>
                <li>Responsive Designs</li>
                <li>Website Performance</li>
                <li>SEO + WP Security Plugins</li>
            </ul>
        </li>
    </ol>
    <div style="margin-top: 2rem" class="external-apps-link">
        <a
            href="/cv_EN_adrianbengoechea_early_aug_2026.pdf"
            target="__blank"
            rel="noopener noreferrer"
        >
            <h3>
                View full resume <i
                    class="fa-solid fa-arrow-up-right-from-square"
                    style="font-size: 1rem;"></i>
            </h3>
        </a>
    </div>
</section>

<style>
    .external-apps-link a h3 {
        text-decoration: underline;
        display: inline-block;
    }
    .external-apps-link a h3:hover {
        text-decoration: none;
    }
    section {
        position: relative;
    }

    h2 {
        font-size: 1.5rem;
        margin-bottom: 1.5rem;
    }

    ol {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    ol > li {
        position: relative;
        padding-left: 1.5rem;
        border-left: 2px solid rgba(148, 163, 184, 0.2);
    }

    .role {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .title {
        font-weight: 600;
        font-size: 1rem;
        color: var(--fg);
    }

    .period {
        font-size: 0.8rem;
        color: var(--light);
        white-space: nowrap;
    }

    .company {
        font-size: 0.85rem;
        color: var(--accent);
        margin: 0.25rem 0 0.5rem;
    }

    .summary {
        font-size: 0.9rem;
        line-height: 1.6;
        margin: 0 0 0.75rem;
    }

    .tags {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .tags li {
        padding: 0.25rem 0.65rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 500;
        background: rgba(148, 163, 184, 0.1);
        color: var(--light);
        border: none;
    }
</style>
